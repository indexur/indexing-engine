{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/submit", "dest": "/api/submit.js" },
    { "src": "/api/index", "dest": "/api/index.js" },
    { "src": "/api/feed", "dest": "/api/feed.js" },
    { "src": "/api/links", "dest": "/api/links.js" },
    { "src": "/api/sitemap", "dest": "/api/sitemap.js" },
    { "src": "/api/wordpress", "dest": "/api/wordpress.js" },
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/api/callback", "dest": "/api/callback.js" },
    { "src": "/feed.xml", "dest": "/api/feed.js" },
    { "src": "/sitemap.xml", "dest": "/api/sitemap.js" },
    { "src": "/links", "dest": "/api/links.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
